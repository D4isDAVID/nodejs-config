{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": { "preferences": { "importModuleSpecifierEnding": "js" } }
      }
    }
  },
  "formatter": [
    { "language_server": { "name": "oxfmt" } },
    { "code_action": "source.fixAll.oxc" }
  ],
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "format_on_save": "on"
    },
    "JSON": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "format_on_save": "on"
    },
    "JSONC": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "format_on_save": "on"
    },
    "Markdown": {
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" }
      ],
      "format_on_save": "on"
    }
  }
}
